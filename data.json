<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Vendor Intelligence Hub</title>

<style>
* {
  box-sizing: border-box;
}

:root {
  --primary: #3157d5;
  --primary-dark: #2444ad;
  --bg: #f5f7fb;
  --card: #ffffff;
  --border: #e3e8f0;
  --text: #172033;
  --muted: #687386;
  --sidebar: #111827;
  --sidebar-text: #cbd5e1;
  --success: #16845b;
  --warning: #b7791f;
  --danger: #c53030;
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

body {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Arial,
    sans-serif;
  background: var(--bg);
  color: var(--text);
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.hidden {
  display: none !important;
}

/* =========================
   LOGIN
========================= */

.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(circle at top left, #dfe7ff 0, transparent 35%),
    radial-gradient(circle at bottom right, #e9ddff 0, transparent 35%),
    #f5f7fb;
}

.login-card {
  width: min(440px, 100%);
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 36px;
  box-shadow: 0 25px 70px rgba(30, 40, 70, 0.12);
}

.logo {
  width: 58px;
  height: 58px;
  border-radius: 17px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #3157d5, #7548dc);
  color: #fff;
  font-size: 20px;
  font-weight: 900;
  margin-bottom: 20px;
}

.login-card h1 {
  margin: 0 0 8px;
  font-size: 28px;
}

.login-subtitle {
  margin: 0 0 28px;
  color: var(--muted);
  line-height: 1.6;
}

.field {
  margin: 17px 0;
}

.field label {
  display: block;
  margin-bottom: 8px;
  font-size: 13px;
  font-weight: 750;
}

input,
select {
  width: 100%;
  border: 1px solid #d7deea;
  border-radius: 11px;
  padding: 12px 13px;
  background: #fff;
  color: var(--text);
  outline: none;
  transition: 0.2s;
}

input:focus,
select:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(49, 87, 213, 0.1);
}

.primary-button {
  width: 100%;
  border: 0;
  border-radius: 11px;
  padding: 13px;
  background: linear-gradient(135deg, var(--primary), #6548d8);
  color: #fff;
  font-weight: 750;
  transition: 0.2s;
}

.primary-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 20px rgba(49, 87, 213, 0.25);
}

.link-button {
  border: 0;
  background: transparent;
  color: var(--primary);
  font-weight: 700;
  padding: 0;
}

.login-error {
  min-height: 18px;
  margin-top: 9px;
  color: var(--danger);
  font-size: 13px;
}

.demo-login {
  margin-top: 20px;
  padding: 11px;
  background: #f5f7fb;
  border-radius: 10px;
  text-align: center;
  color: var(--muted);
  font-size: 12px;
}

/* =========================
   APP LAYOUT
========================= */

.app {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 245px;
  background: var(--sidebar);
  color: #fff;
  padding: 24px 15px;
  z-index: 10;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px 28px;
}

.sidebar-logo {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #3157d5, #7548dc);
  font-size: 13px;
  font-weight: 900;
}

.sidebar-brand-text strong {
  display: block;
  font-size: 14px;
}

.sidebar-brand-text span {
  display: block;
  color: #94a3b8;
  font-size: 11px;
  margin-top: 3px;
}

.sidebar-section {
  margin: 12px 10px 8px;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 10px;
  font-weight: 800;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 12px;
  margin: 4px 0;
  border-radius: 10px;
  border: 0;
  background: transparent;
  color: var(--sidebar-text);
  text-align: left;
  font-size: 13px;
}

.nav-item:hover,
.nav-item.active {
  background: #1e293b;
  color: #fff;
}

.nav-icon {
  width: 21px;
  text-align: center;
}

.main-area {
  width: calc(100% - 245px);
  margin-left: 245px;
  min-height: 100vh;
}

.topbar {
  height: 70px;
  background: #fff;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 30px;
  position: sticky;
  top: 0;
  z-index: 8;
}

.topbar-title {
  font-weight: 800;
  font-size: 15px;
}

.topbar-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12px;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  color: var(--muted);
}

.user-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #e9edff;
  color: var(--primary);
  font-weight: 800;
}

.signout-button {
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 9px;
  padding: 8px 12px;
  color: #344054;
}

.signout-button:hover {
  background: #f8fafc;
}

/* =========================
   CONTENT
========================= */

.content {
  max-width: 1450px;
  margin: 0 auto;
  padding: 30px;
}

.welcome {
  margin-bottom: 25px;
}

.welcome h1 {
  margin: 0 0 7px;
  font-size: 30px;
  letter-spacing: -0.5px;
}

.welcome p {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
}

/* =========================
   STATS
========================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-bottom: 22px;
}

.stat-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 19px;
  box-shadow: 0 5px 18px rgba(20, 30, 50, 0.03);
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 13px;
}

.stat-label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
}

.stat-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: #eef2ff;
  color: var(--primary);
}

.stat-number {
  font-size: 27px;
  font-weight: 850;
}

/* =========================
   SEARCH
========================= */

.search-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 17px;
  padding: 20px;
  margin-bottom: 20px;
}

.search-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 15px;
}

.search-header h2 {
  margin: 0;
  font-size: 16px;
}

.search-header span {
  color: var(--muted);
  font-size: 12px;
}

.search-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 11px;
}

.search-input-wrap {
  position: relative;
}

.search-input-wrap input {
  padding-left: 39px;
}

.search-icon {
  position: absolute;
  left: 13px;
  top: 50%;
  transform: translateY(-50%);
  color: #8b95a7;
}

/* =========================
   RESULTS
========================= */

.results-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 13px;
}

.results-count {
  color: var(--muted);
  font-size: 13px;
}

.toolbar-actions {
  display: flex;
  gap: 8px;
}

.secondary-button {
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 9px;
  padding: 8px 11px;
  color: #344054;
  font-size: 12px;
  font-weight: 650;
}

.secondary-button:hover {
  background: #f8fafc;
}

.categories {
  display: grid;
  gap: 13px;
}

.category-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(20, 30, 50, 0.025);
}

.category-header {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 0;
  background: #fff;
  padding: 17px 19px;
  text-align: left;
}

.category-header:hover {
  background: #fafbfe;
}

.category-name {
  flex: 1;
  font-size: 15px;
  font-weight: 800;
}

.category-count {
  background: #eef2ff;
  color: var(--primary);
  border-radius: 999px;
  padding: 5px 9px;
  font-size: 11px;
  font-weight: 800;
}

.chevron {
  color: #8b95a7;
  font-size: 14px;
  transition: 0.2s;
}

.category-card.open .chevron {
  transform: rotate(180deg);
}

.category-body {
  border-top: 1px solid #edf0f5;
  padding: 4px 19px 14px;
}

.task-row {
  padding: 15px 0;
  border-bottom: 1px solid #edf0f5;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;
}

.task-name {
  font-weight: 750;
  font-size: 14px;
}

.task-status {
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 800;
}

.status-healthy {
  background: #e8f7f0;
  color: var(--success);
}

.status-banned {
  background: #fdecec;
  color: var(--danger);
}

.status-saturated {
  background: #fff3dd;
  color: #9a6700;
}

.status-near {
  background: #fff6e6;
  color: var(--warning);
}

.status-default {
  background: #eef2f4;
  color: #475467;
}

.examples {
  margin-top: 7px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.55;
}

.empty-state {
  background: #fff;
  border: 1px dashed #cdd5e1;
  border-radius: 16px;
  padding: 55px 20px;
  text-align: center;
  color: var(--muted);
}

.empty-icon {
  font-size: 35px;
  margin-bottom: 10px;
}

.empty-state strong {
  display: block;
  color: var(--text);
  margin-bottom: 5px;
}

/* =========================
   MODAL
========================= */

.modal {
  position: fixed;
  inset: 0;
  background: rgba(8, 15, 30, 0.58);
  display: grid;
  place-items: center;
  padding: 20px;
  z-index: 50;
}

.modal-box {
  width: min(440px, 100%);
  background: #fff;
  border-radius: 18px;
  padding: 26px;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.2);
}

.modal-box h3 {
  margin: 0 0 7px;
  font-size: 19px;
}

.modal-description {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 20px;
}

.modal-actions .primary-small {
  width: auto;
  padding: 10px 15px;
}

/* =========================
   LOADING
========================= */

.loading {
  text-align: center;
  padding: 50px;
  color: var(--muted);
}

.spinner {
  width: 30px;
  height: 30px;
  border: 3px solid #e2e8f0;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 12px;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* =========================
   MOBILE
========================= */

.mobile-menu {
  display: none;
  border: 0;
  background: transparent;
  font-size: 22px;
  margin-right: 10px;
}

@media (max-width: 1050px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .search-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .sidebar {
    width: 72px;
    padding: 20px 9px;
  }

  .sidebar-brand-text,
  .sidebar-section,
  .nav-item span:not(.nav-icon) {
    display: none;
  }

  .sidebar-brand {
    justify-content: center;
    padding: 0 0 24px;
  }

  .nav-item {
    justify-content: center;
    padding: 12px;
  }

  .main-area {
    width: calc(100% - 72px);
    margin-left: 72px;
  }

  .content {
    padding: 22px 16px;
  }

  .topbar {
    padding: 0 16px;
  }

  .user-chip {
    display: none;
  }
}

@media (max-width: 620px) {
  .login-card {
    padding: 27px 22px;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-number {
    font-size: 23px;
  }

  .welcome h1 {
    font-size: 25px;
  }

  .search-card {
    padding: 15px;
  }

  .results-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .toolbar-actions {
    width: 100%;
  }

  .toolbar-actions button {
    flex: 1;
  }

  .category-header {
    padding: 15px;
  }

  .category-body {
    padding-left: 15px;
    padding-right: 15px;
  }

  .category-name {
    font-size: 13px;
  }

  .category-count {
    font-size: 10px;
  }

  .signout-button {
    padding: 7px 9px;
    font-size: 12px;
  }
}
</style>
</head>

<body>

<!-- ============================================================
     LOGIN PAGE
============================================================ -->

<div id="loginPage" class="login-page">

  <div class="login-card">

    <div class="logo">
      VH
    </div>

    <h1>Vendor Intelligence Hub</h1>

    <p class="login-subtitle">
      Search vendor categories, works, tasks and examples from your
      central business data.
    </p>

    <form id="loginForm">

      <div class="field">
        <label for="username">
          Username
        </label>

        <input
          id="username"
          type="text"
          placeholder="Enter username"
          autocomplete="username"
          required
        >
      </div>

      <div class="field">
        <label for="password">
          Password
        </label>

        <input
          id="password"
          type="password"
          placeholder="Enter password"
          autocomplete="current-password"
          required
        >
      </div>

      <button
        type="submit"
        class="primary-button"
      >
        Sign In
      </button>

      <div
        id="loginError"
        class="login-error"
      ></div>

    </form>

    <p style="text-align:center;margin-top:20px">
      <button
        id="forgotButton"
        class="link-button"
        type="button"
      >
        Reset username / password
      </button>
    </p>

    <div class="demo-login">
      Demo login:
      <strong>admin</strong>
      /
      <strong>admin123</strong>
    </div>

  </div>

</div>


<!-- ============================================================
     APPLICATION
============================================================ -->

<div id="application" class="app hidden">

  <!-- SIDEBAR -->

  <aside class="sidebar">

    <div class="sidebar-brand">

      <div class="sidebar-logo">
        VH
      </div>

      <div class="sidebar-brand-text">
        <strong>Vendor Hub</strong>
        <span>Business Intelligence</span>
      </div>

    </div>

    <div class="sidebar-section">
      Navigation
    </div>

    <button
      class="nav-item active"
      type="button"
    >
      <span class="nav-icon">⌂</span>
      <span>Dashboard</span>
    </button>

    <button
      class="nav-item"
      type="button"
      onclick="focusSearch()"
    >
      <span class="nav-icon">⌕</span>
      <span>Category Search</span>
    </button>

    <button
      class="nav-item"
      type="button"
      onclick="focusSearch()"
    >
      <span class="nav-icon">▤</span>
      <span>Work & Tasks</span>
    </button>

    <button
      class="nav-item"
      type="button"
      onclick="showStatusOverview()"
    >
      <span class="nav-icon">◉</span>
      <span>Status Overview</span>
    </button>

  </aside>


  <!-- MAIN -->

  <div class="main-area">

    <!-- TOPBAR -->

    <header class="topbar">

      <div class="topbar-title">
        Vendor Intelligence Hub
      </div>

      <div class="topbar-right">

        <div class="user-chip">

          <div
            id="userAvatar"
            class="user-avatar"
          >
            A
          </div>

          <span id="currentUsername">
            Admin
          </span>

        </div>

        <button
          id="signOutButton"
          class="signout-button"
          type="button"
        >
          Sign out
        </button>

      </div>

    </header>


    <!-- CONTENT -->

    <main class="content">

      <!-- WELCOME -->

      <section class="welcome">

        <h1>
          Find Categories & Works
        </h1>

        <p>
          Search your vendor database by category, task, work,
          examples or status.
        </p>

      </section>


      <!-- STATISTICS -->

      <section class="stats-grid">

        <div class="stat-card">

          <div class="stat-top">

            <span class="stat-label">
              Categories
            </span>

            <div class="stat-icon">
              ◈
            </div>

          </div>

          <div
            id="categoryCount"
            class="stat-number"
          >
            0
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-top">

            <span class="stat-label">
              Total Works
            </span>

            <div class="stat-icon">
              ▤
            </div>

          </div>

          <div
            id="workCount"
            class="stat-number"
          >
            0
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-top">

            <span class="stat-label">
              Healthy
            </span>

            <div class="stat-icon">
              ✓
            </div>

          </div>

          <div
            id="healthyCount"
            class="stat-number"
          >
            0
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-top">

            <span class="stat-label">
              Current Results
            </span>

            <div class="stat-icon">
              ⌕
            </div>

          </div>

          <div
            id="resultCount"
            class="stat-number"
          >
            0
          </div>

        </div>

      </section>


      <!-- SEARCH -->

      <section class="search-card">

        <div class="search-header">

          <h2>
            Search Database
          </h2>

          <span>
            Data source: veka.xlsx → data.json
          </span>

        </div>


        <div class="search-grid">

          <div class="search-input-wrap">

            <span class="search-icon">
              ⌕
            </span>

            <input
              id="searchInput"
              type="search"
              placeholder="Search category, task, examples or status..."
            >

          </div>


          <select id="categoryFilter">
            <option value="">
              All Categories
            </option>
          </select>


          <select id="statusFilter">
            <option value="">
              All Statuses
            </option>
          </select>

        </div>

      </section>


      <!-- RESULTS TOOLBAR -->

      <div class="results-toolbar">

        <div
          id="resultsText"
          class="results-count"
        >
          Loading results...
        </div>

        <div class="toolbar-actions">

          <button
            id="expandAllButton"
            class="secondary-button"
            type="button"
          >
            Expand All
          </button>

          <button
            id="collapseAllButton"
            class="secondary-button"
            type="button"
          >
            Collapse All
          </button>

        </div>

      </div>


      <!-- RESULTS -->

      <section
        id="resultsContainer"
        class="categories"
      >

        <div class="loading">

          <div class="spinner"></div>

          Loading vendor data...

        </div>

      </section>

    </main>

  </div>

</div>


<!-- ============================================================
     RESET MODAL
============================================================ -->

<div
  id="resetModal"
  class="modal hidden"
>

  <div class="modal-box">

    <h3>
      Reset Login
    </h3>

    <p class="modal-description">
      This demo stores the username and password only in this
      browser using localStorage.
    </p>


    <div class="field">

      <label for="newUsername">
        New Username
      </label>

      <input
        id="newUsername"
        type="text"
        placeholder="Enter new username"
      >

    </div>


    <div class="field">

      <label for="newPassword">
        New Password
      </label>

      <input
        id="newPassword"
        type="password"
        placeholder="Enter new password"
      >

    </div>


    <div class="modal-actions">

      <button
        id="cancelReset"
        class="secondary-button"
        type="button"
      >
        Cancel
      </button>

      <button
        id="saveReset"
        class="primary-button primary-small"
        type="button"
      >
        Save Changes
      </button>

    </div>

  </div>

</div>


<script>

/* ============================================================
   APPLICATION STATE
============================================================ */

let vendorData = [];


/* ============================================================
   HELPER
============================================================ */

const $ = (id) => document.getElementById(id);


function escapeHTML(value) {

  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}


/* ============================================================
   LOGIN CREDENTIALS
============================================================ */

function getCredentials() {

  return {

    username:
      localStorage.getItem("vendor_hub_username")
      || "admin",

    password:
      localStorage.getItem("vendor_hub_password")
      || "admin123"

  };

}


/* ============================================================
   LOGIN
============================================================ */

$("loginForm").addEventListener("submit", function(event) {

  event.preventDefault();

  const username =
    $("username").value.trim();

  const password =
    $("password").value;

  const credentials =
    getCredentials();


  if (
    username === credentials.username &&
    password === credentials.password
  ) {

    localStorage.setItem(
      "vendor_hub_authenticated",
      "true"
    );

    $("loginError").textContent = "";

    openApplication();

  } else {

    $("loginError").textContent =
      "Invalid username or password.";

  }

});


/* ============================================================
   OPEN APPLICATION
============================================================ */

function openApplication() {

  $("loginPage").classList.add("hidden");

  $("application").classList.remove("hidden");

  const credentials =
    getCredentials();

  $("currentUsername").textContent =
    credentials.username;

  $("userAvatar").textContent =
    credentials.username
      .charAt(0)
      .toUpperCase();

  loadVendorData();

}


/* ============================================================
   LOGOUT
============================================================ */

$("signOutButton").addEventListener(
  "click",
  function() {

    localStorage.removeItem(
      "vendor_hub_authenticated"
    );

    $("application").classList.add(
      "hidden"
    );

    $("loginPage").classList.remove(
      "hidden"
    );

    $("username").value = "";
    $("password").value = "";

  }
);


/* ============================================================
   RESET LOGIN
============================================================ */

$("forgotButton").addEventListener(
  "click",
  function() {

    $("resetModal").classList.remove(
      "hidden"
    );

  }
);


$("cancelReset").addEventListener(
  "click",
  function() {

    $("resetModal").classList.add(
      "hidden"
    );

  }
);


$("saveReset").addEventListener(
  "click",
  function() {

    const newUsername =
      $("newUsername").value.trim();

    const newPassword =
      $("newPassword").value;


    if (!newUsername || !newPassword) {

      alert(
        "Please enter both username and password."
      );

      return;

    }


    localStorage.setItem(
      "vendor_hub_username",
      newUsername
    );

    localStorage.setItem(
      "vendor_hub_password",
      newPassword
    );


    $("newUsername").value = "";
    $("newPassword").value = "";

    $("resetModal").classList.add(
      "hidden"
    );


    alert(
      "Username and password have been updated."
    );

  }
);


/* ============================================================
   LOAD DATA.JSON
============================================================ */

async function loadVendorData() {

  $("resultsContainer").innerHTML = `
    <div class="loading">
      <div class="spinner"></div>
      Loading vendor data...
    </div>
  `;


  try {

    const response =
      await fetch(
        "data.json?ts=" + Date.now(),
        {
          cache: "no-store"
        }
      );


    if (!response.ok) {

      throw new Error(
        "data.json could not be loaded."
      );

    }


    vendorData =
      await response.json();


    populateFilters();

    updateStatistics();

    renderResults();


  } catch (error) {

    console.error(error);


    $("resultsContainer").innerHTML = `

      <div class="empty-state">

        <div class="empty-icon">
          ⚠
        </div>

        <strong>
          Data could not be loaded
        </strong>

        <div>
          Please make sure
          <b>data.json</b>
          exists in the same GitHub folder as
          <b>index.html</b>.
        </div>

      </div>

    `;

    $("resultsText").textContent =
      "Unable to load data.";

  }

}


/* ============================================================
   POPULATE FILTERS
============================================================ */

function populateFilters() {

  const categories =
    [
      ...new Set(
        vendorData
          .map(item => item.category)
          .filter(Boolean)
      )
    ]
    .sort(
      (a, b) =>
        String(a).localeCompare(
          String(b)
        )
    );


  const statuses =
    [
      ...new Set(
        vendorData
          .map(item => item.status)
          .filter(Boolean)
      )
    ]
    .sort(
      (a, b) =>
        String(a).localeCompare(
          String(b)
        )
    );


  $("categoryFilter").innerHTML =
    `<option value="">All Categories</option>` +
    categories
      .map(
        category =>
          `<option value="${escapeHTML(category)}">
            ${escapeHTML(category)}
          </option>`
      )
      .join("");


  $("statusFilter").innerHTML =
    `<option value="">All Statuses</option>` +
    statuses
      .map(
        status =>
          `<option value="${escapeHTML(status)}">
            ${escapeHTML(status)}
          </option>`
      )
      .join("");

}


/* ============================================================
   STATISTICS
============================================================ */

function updateStatistics() {

  const categories =
    new Set(
      vendorData
        .map(item => item.category)
        .filter(Boolean)
    );


  const healthy =
    vendorData.filter(
      item =>
        String(item.status || "")
          .toLowerCase()
          .trim() === "healthy"
    );


  $("categoryCount").textContent =
    categories.size;

  $("workCount").textContent =
    vendorData.length;

  $("healthyCount").textContent =
    healthy.length;

}


/* ============================================================
   FILTER DATA
============================================================ */

function getFilteredData() {

  const search =
    $("searchInput")
      .value
      .toLowerCase()
      .trim();


  const selectedCategory =
    $("categoryFilter").value;


  const selectedStatus =
    $("statusFilter").value;


  return vendorData.filter(
    item => {

      const searchableText = [

        item.category,
        item.task,
        item.examples,
        item.status

      ]
        .join(" ")
        .toLowerCase();


      const matchesSearch =
        !search ||
        searchableText.includes(search);


      const matchesCategory =
        !selectedCategory ||
        item.category === selectedCategory;


      const matchesStatus =
        !selectedStatus ||
        item.status === selectedStatus;


      return (
        matchesSearch &&
        matchesCategory &&
        matchesStatus
      );

    }
  );

}


/* ============================================================
   STATUS CLASS
============================================================ */

function getStatusClass(status) {

  const value =
    String(status || "")
      .toLowerCase()
      .trim();


  if (value === "healthy") {

    return "status-healthy";

  }


  if (value === "banned") {

    return "status-banned";

  }


  if (value === "saturated") {

    return "status-saturated";

  }


  if (
    value === "near saturated" ||
    value === "near-saturated"
  ) {

    return "status-near";

  }


  return "status-default";

}


/* ============================================================
   RENDER RESULTS
============================================================ */

function renderResults() {

  const filtered =
    getFilteredData();


  $("resultCount").textContent =
    filtered.length;


  $("resultsText").textContent =
    `${filtered.length.toLocaleString()} matching works`;


  if (!filtered.length) {

    $("resultsContainer").innerHTML = `

      <div class="empty-state">

        <div class="empty-icon">
          ⌕
        </div>

        <strong>
          No matching tasks found
        </strong>

        <div>
          Try another search term or change the filters.
        </div>

      </div>

    `;

    return;

  }


  /*
    Group records by category.
  */

  const grouped = {};


  filtered.forEach(
    item => {

      const category =
        item.category || "Uncategorized";


      if (!grouped[category]) {

        grouped[category] = [];

      }


      grouped[category].push(item);

    }
  );


  const categoryNames =
    Object.keys(grouped).sort(
      (a, b) =>
        String(a).localeCompare(
          String(b)
        )
    );


  $("resultsContainer").innerHTML =
    categoryNames
      .map(
        (category, index) => {

          const tasks =
            grouped[category];


          return `

            <article
              class="category-card ${index === 0 ? "open" : ""}"
            >

              <button
                class="category-header"
                type="button"
                onclick="toggleCategory(this)"
              >

                <span class="category-name">
                  ${escapeHTML(category)}
                </span>

                <span class="category-count">
                  ${tasks.length}
                  ${tasks.length === 1 ? "work" : "works"}
                </span>

                <span class="chevron">
                  ▼
                </span>

              </button>


              <div
                class="category-body"
                style="${index === 0 ? "" : "display:none"}"
              >

                ${tasks
                  .map(
                    item => `

                      <div class="task-row">

                        <div class="task-title-line">

                          <span class="task-name">
                            ${escapeHTML(item.task)}
                          </span>

                          ${
                            item.status
                              ? `
                                <span
                                  class="task-status ${getStatusClass(item.status)}"
                                >
                                  ${escapeHTML(item.status)}
                                </span>
                              `
                              : ""
                          }

                        </div>


                        ${
                          item.examples
                            ? `
                              <div class="examples">
                                ${escapeHTML(item.examples)}
                              </div>
                            `
                            : ""
                        }

                      </div>

                    `
                  )
                  .join("")}

              </div>

            </article>

          `;

        }
      )
      .join("");

}


/* ============================================================
   TOGGLE CATEGORY
============================================================ */

function toggleCategory(button) {

  const card =
    button.closest(".category-card");

  const body =
    button.nextElementSibling;


  const isOpen =
    body.style.display !== "none";


  if (isOpen) {

    body.style.display = "none";

    card.classList.remove(
      "open"
    );

  } else {

    body.style.display = "block";

    card.classList.add(
      "open"
    );

  }

}


/* ============================================================
   EXPAND ALL
============================================================ */

$("expandAllButton").addEventListener(
  "click",
  function() {

    document
      .querySelectorAll(".category-card")
      .forEach(
        card => {

          card.classList.add(
            "open"
          );

          const body =
            card.querySelector(
              ".category-body"
            );

          body.style.display =
            "block";

        }
      );

  }
);


/* ============================================================
   COLLAPSE ALL
============================================================ */

$("collapseAllButton").addEventListener(
  "click",
  function() {

    document
      .querySelectorAll(".category-card")
      .forEach(
        card => {

          card.classList.remove(
            "open"
          );

          const body =
            card.querySelector(
              ".category-body"
            );

          body.style.display =
            "none";

        }
      );

  }
);


/* ============================================================
   SEARCH EVENTS
============================================================ */

$("searchInput").addEventListener(
  "input",
  renderResults
);


$("categoryFilter").addEventListener(
  "change",
  renderResults
);


$("statusFilter").addEventListener(
  "change",
  renderResults
);


/* ============================================================
   NAVIGATION
============================================================ */

function focusSearch() {

  $("searchInput").focus();

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

}


function showStatusOverview() {

  $("statusFilter").focus();

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

}


/* ============================================================
   CLOSE MODAL WHEN CLICKING OUTSIDE
============================================================ */

$("resetModal").addEventListener(
  "click",
  function(event) {

    if (
      event.target ===
      $("resetModal")
    ) {

      $("resetModal").classList.add(
        "hidden"
      );

    }

  }
);


/* ============================================================
   CHECK EXISTING LOGIN
============================================================ */

if (
  localStorage.getItem(
    "vendor_hub_authenticated"
  ) === "true"
) {

  openApplication();

}

</script>

</body>
</html>